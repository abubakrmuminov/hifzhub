[
  {
    "id": 1,
    "ayahId": 1,
    "language": "uz",
    "translator": "Mansur",
    "text": "Mehribon va rahmli Alloh nomi bilan"
  },
  {
    "id": 2,
    "ayahId": 2,
    "language": "uz",
    "translator": "Mansur",
    "text": "Hamdu sano butun olamlar Parvardigori Alloh uchundir."
  },
  {
    "id": 3,
    "ayahId": 3,
    "language": "uz",
    "translator": "Mansur",
    "text": "Mehribon va Rahmli."
  },
  {
    "id": 4,
    "ayahId": 4,
    "language": "uz",
    "translator": "Mansur",
    "text": "Jazo (Qiyomat) kunining Egasi — Podshohi."
  },
  {
    "id": 5,
    "ayahId": 5,
    "language": "uz",
    "translator": "Mansur",
    "text": "Sengagina ibodat qilamiz va Sendangina madad so'raymiz."
  },
  {
    "id": 6,
    "ayahId": 6,
    "language": "uz",
    "translator": "Mansur",
    "text": "Bizlarni To'g'ri Yo'lga yo'llagaysan."
  },
  {
    "id": 7,
    "ayahId": 7,
    "language": "uz",
    "translator": "Mansur",
    "text": "U shunday zotlarning yo'liki, Sen O'zing ularga in'om qilgansan — ular g'azabga duchor bo'lmagan va zalolatga ketmagan — adashmaganlarning yo'lidir."
  },
  {
    "id": 8,
    "ayahId": 6222,
    "language": "uz",
    "translator": "Mansur",
    "text": "Ayting: «U — Alloh Birdir»."
  },
  {
    "id": 9,
    "ayahId": 6223,
    "language": "uz",
    "translator": "Mansur",
    "text": "Alloh behojat, (barcha hojatlar bilan) ko'zlanguchidir."
  },
  {
    "id": 10,
    "ayahId": 6224,
    "language": "uz",
    "translator": "Mansur",
    "text": "U tug'magan va tug'ilmagandir."
  },
  {
    "id": 11,
    "ayahId": 6225,
    "language": "uz",
    "translator": "Mansur",
    "text": "Va hech kim U zotga teng emasdir»."
  },
  {
    "id": 12,
    "ayahId": 6226,
    "language": "uz",
    "translator": "Mansur",
    "text": "Ayting: «Men tong Parvardigoridan panoh so'rayman;"
  },
  {
    "id": 13,
    "ayahId": 6227,
    "language": "uz",
    "translator": "Mansur",
    "text": "O'zi yaratgan narsalarning yomonligidan;"
  },
  {
    "id": 14,
    "ayahId": 6228,
    "language": "uz",
    "translator": "Mansur",
    "text": "Zulmatga cho'mgan kechaning yomonligidan;"
  },
  {
    "id": 15,
    "ayahId": 6229,
    "language": "uz",
    "translator": "Mansur",
    "text": "Tugunlarga dam soluvchi (jodugar)larning yomonligidan;"
  },
  {
    "id": 16,
    "ayahId": 6230,
    "language": "uz",
    "translator": "Mansur",
    "text": "Va hasad qilayotgan hasadgo'yning yomonligidan»."
  },
  {
    "id": 17,
    "ayahId": 6231,
    "language": "uz",
    "translator": "Mansur",
    "text": "Ayting: «Men barcha insonlarning Parvardigoridan,"
  },
  {
    "id": 18,
    "ayahId": 6232,
    "language": "uz",
    "translator": "Mansur",
    "text": "Barcha insonlarning Podshohidan,"
  },
  {
    "id": 19,
    "ayahId": 6233,
    "language": "uz",
    "translator": "Mansur",
    "text": "Barcha insonlarning Ilohidan panoh so'rayman,"
  },
  {
    "id": 20,
    "ayahId": 6234,
    "language": "uz",
    "translator": "Mansur",
    "text": "Yashirinib oluvchi vasvasachining yomonligidan,"
  },
  {
    "id": 21,
    "ayahId": 6235,
    "language": "uz",
    "translator": "Mansur",
    "text": "U insonlarning dillariga vasvasa soladigan,"
  },
  {
    "id": 22,
    "ayahId": 6236,
    "language": "uz",
    "translator": "Mansur",
    "text": "Jinlar va insonlardan bo'lgan (shaytondan)»."
  }
]