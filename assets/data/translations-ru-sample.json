[
  {
    "id": 1,
    "ayahId": 1,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Во имя Аллаха, Милостивого, Милосердного!"
  },
  {
    "id": 2,
    "ayahId": 2,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Хвала Аллаху, Господу миров,"
  },
  {
    "id": 3,
    "ayahId": 3,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Милостивому, Милосердному,"
  },
  {
    "id": 4,
    "ayahId": 4,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Властелину Дня воздаяния!"
  },
  {
    "id": 5,
    "ayahId": 5,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Тебе одному мы поклоняемся и Тебя одного молим о помощи."
  },
  {
    "id": 6,
    "ayahId": 6,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Веди нас прямым путем,"
  },
  {
    "id": 7,
    "ayahId": 7,
    "language": "ru",
    "translator": "Кулиев",
    "text": "путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших."
  },
  {
    "id": 8,
    "ayahId": 6222,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Скажи: «Он — Аллах Единый,"
  },
  {
    "id": 9,
    "ayahId": 6223,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Аллах Самодостаточный."
  },
  {
    "id": 10,
    "ayahId": 6224,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Он не родил и не был рожден,"
  },
  {
    "id": 11,
    "ayahId": 6225,
    "language": "ru",
    "translator": "Кулиев",
    "text": "и нет никого равного Ему»."
  },
  {
    "id": 12,
    "ayahId": 6226,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Скажи: «Прибегаю к защите Господа рассвета"
  },
  {
    "id": 13,
    "ayahId": 6227,
    "language": "ru",
    "translator": "Кулиев",
    "text": "от зла того, что Он сотворил,"
  },
  {
    "id": 14,
    "ayahId": 6228,
    "language": "ru",
    "translator": "Кулиев",
    "text": "от зла мрака, когда он наступает,"
  },
  {
    "id": 15,
    "ayahId": 6229,
    "language": "ru",
    "translator": "Кулиев",
    "text": "от зла колдуний, поплевывающих на узлы,"
  },
  {
    "id": 16,
    "ayahId": 6230,
    "language": "ru",
    "translator": "Кулиев",
    "text": "от зла завистника, когда он завидует»."
  },
  {
    "id": 17,
    "ayahId": 6231,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Скажи: «Прибегаю к защите Господа людей,"
  },
  {
    "id": 18,
    "ayahId": 6232,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Царя людей,"
  },
  {
    "id": 19,
    "ayahId": 6233,
    "language": "ru",
    "translator": "Кулиев",
    "text": "Бога людей,"
  },
  {
    "id": 20,
    "ayahId": 6234,
    "language": "ru",
    "translator": "Кулиев",
    "text": "от зла искусителя исчезающего при поминании Аллаха,"
  },
  {
    "id": 21,
    "ayahId": 6235,
    "language": "ru",
    "translator": "Кулиев",
    "text": "который наущает в груди людей"
  },
  {
    "id": 22,
    "ayahId": 6236,
    "language": "ru",
    "translator": "Кулиев",
    "text": "и бывает из джиннов и людей»."
  }
]