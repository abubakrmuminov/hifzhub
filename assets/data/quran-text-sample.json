    "hizb": 60,
    "page": 604
  },
  {
    "id": 6234,
    "surahId": 114,
    "ayahNumber": 4,
    "textUthmani": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
